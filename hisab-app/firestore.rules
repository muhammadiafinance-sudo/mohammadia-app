rules_version = '2';
// Firestore Rules for the NEW Mohammadia Hisab project.
// Paste into Firebase Console → Firestore Database → Rules → Publish.
// The emails must match hisab-app/config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth != null ? request.auth.token.email : ''; }
    function isBank() { return email() == 'muhammadiafinance+bank@gmail.com'; }
    function isShop() { return email() == 'muhammadiafinance+shop@gmail.com'; }

    // Bank login: DBBL Daily Hisab, remittance and forms (all stored in hisab_dbbl)
    match /mohammadia_library/main_db/hisab_dbbl/{doc}       { allow read, write: if isBank(); }
    match /mohammadia_library/main_db/hisab_dbbl_trash/{doc} { allow read, write: if isBank(); }

    // Shop login: Daily Hisab only
    match /mohammadia_library/main_db/hisab_daily/{doc}       { allow read, write: if isShop(); }
    match /mohammadia_library/main_db/hisab_daily_trash/{doc} { allow read, write: if isShop(); }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
