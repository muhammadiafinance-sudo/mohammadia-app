rules_version = '2';
// Firestore Rules for the shop app (project: mohammadia-stock).
// Paste into Firebase Console → Firestore Database → Rules → Publish.
//
// Two logins (emails must match ROLE_EMAILS in index.html):
//   Shop     = admin    → everything
//   Employee = employee → day-to-day shop work; deleting is admin-only
service cloud.firestore {
  match /databases/{database}/documents {
    function email()      { return request.auth != null ? request.auth.token.email : ''; }
    function isAdmin()    { return email() == 'muhammadiafinance+admin@gmail.com'; }
    function isEmployee() { return email() == 'muhammadiafinance+employee@gmail.com'; }
    function isStaff()    { return isAdmin() || isEmployee(); }

    // Shop state: stock, daily cash, purchases, settings (one document)
    match /mohammadia_library/main_db {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    // One document per sale / warranty phone
    match /mohammadia_library/main_db/sales/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();                 // only a full backup restore deletes sales
    }
    match /mohammadia_library/main_db/warranty/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // Signed-in devices: 2 per profile. Shop uses shop1/shop2, Employee uses emp1/emp2
    // (slot1/slot2 = places from before this change, still allowed so nobody is logged out).
    function shopSlot(id) { return id in ['shop1', 'shop2']; }
    function empSlot(id)  { return id in ['emp1', 'emp2']; }
    function anySlot(id)  { return shopSlot(id) || empSlot(id) || id in ['slot1', 'slot2']; }
    match /mohammadia_library/main_db/sessions/{sid} {
      allow read: if isAdmin() || (isStaff() && anySlot(sid));
      // a login takes a place of its own profile only
      allow create, update: if request.resource.data.uid == request.auth.uid
                            && ((isAdmin() && (shopSlot(sid) || sid in ['slot1', 'slot2']))
                             || (isEmployee() && (empSlot(sid) || sid in ['slot1', 'slot2'])));
      // logging a device out (Active Sessions, password reset, same device moving): only the revoked fields change
      allow update: if isStaff() && anySlot(sid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt', 'revokedBy'])
                    && request.resource.data.revoked == true;
      allow delete: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
    }
    // Old Bank portal / Daily Hisab data (no longer used by this app): kept, Shop login only
    match /mohammadia_library/main_db/{col}/{id} {
      allow read, write: if isAdmin() && col.matches('hisab_.*');
    }
    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
